{
  "name": "choirscore",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @choirscore/web",
    "lint": "npm run lint --workspaces --if-present",
    "pretest": "npm run build --workspace @choirscore/shared",
    "test": "npm run test --workspaces --if-present",
    "pretypecheck": "npm run build --workspace @choirscore/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:playback-sample-budget": "node scripts/check-playback-sample-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
