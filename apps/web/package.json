{
  "name": "@choirscore/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e playwright.config.ts --ext .ts,.tsx",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@choirscore/shared": "0.0.0",
    "opensheetmusicdisplay": "^1.9.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "tonal": "^6.4.2",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
