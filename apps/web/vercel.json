{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npm run build --workspace @choirscore/shared && npm run build --workspace @choirscore/web",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${PXXL_API_URL}/$1",
      "env": ["PXXL_API_URL"]
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
