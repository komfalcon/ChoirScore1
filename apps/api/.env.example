PORT=4000
NODE_ENV=development
DATABASE_URL=libsql://your-turso-db-url
DATABASE_AUTH_TOKEN=your-turso-auth-token
JWT_SECRET=replace-with-at-least-32-random-bytes
COOKIE_DOMAIN=
ALLOWED_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=1
AI_PROVIDER=mistral
# Privileged deployment configuration only, never user input. Blank uses the official
# https://api.mistral.ai/v1/chat/completions endpoint. A nonblank value must be the
# full trusted HTTPS chat-completions endpoint; its path is used as-is (not appended).
# Redirects are rejected. Timeout is 60s per HTTP attempt; initial + up to two repairs
# may use up to six attempts. A timeout retry may leave upstream work/cost ambiguous.
# Endpoint values and secrets are never logged.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=mistral-large-latest
AI_MODEL_LIGHT=mistral-small-latest
AI_DAILY_LIMIT_DEFAULT=20
# Reserved future setting; current job/provider code does not enforce measure caps or chunking.
AI_MAX_MEASURES_PER_CALL=64
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password
